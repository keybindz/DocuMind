# Copy to .env for local (non-docker) runs. docker-compose sets its own
# equivalents directly in docker-compose.yml.

ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://documind:documind@localhost:5432/documind
AUTO_CREATE_TABLES=true

SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

STORAGE_DIR=./storage_data

# --- Phase 2 ---
CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=30

EMBEDDING_BACKEND=sentence-transformers   # or "fake" (tests only)
EMBEDDING_DIMENSION=384

VECTOR_STORE_BACKEND=qdrant               # or "memory" (tests only)
QDRANT_URL=http://localhost:6333

# Optional — unset means /v1/query returns retrieval results without a
# synthesized answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
RAG_TOP_K=5

# --- Phase 3 ---
# The API must connect as a NON-superuser role or Postgres skips RLS entirely.
# DATABASE_URL=postgresql+psycopg2://documind_app:documind_app@localhost:5432/documind
# MIGRATION_DATABASE_URL=postgresql+psycopg2://documind:documind@localhost:5432/documind
RATE_LIMIT_BACKEND=redis                  # or "memory" (tests / single process)
REDIS_URL=redis://localhost:6379/0

# --- Phase 4 ---
TASK_QUEUE_BACKEND=celery
CELERY_BROKER_URL=redis://localhost:6379/1
INGESTION_MAX_RETRIES=3
IDEMPOTENCY_TTL_HOURS=24
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_SECONDS=5
# DEV ONLY. Leave unset/false in production: it disables the SSRF protection on webhook URLs.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# Optional dedicated key for encrypting webhook secrets at rest (defaults to one derived from SECRET_KEY).
# WEBHOOK_ENCRYPTION_KEY=
# Run the worker with:  celery -A app.worker.celery_app worker --loglevel=info
